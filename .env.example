# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Modern publishable key (sb_publishable_...). The legacy `anon` JWT still
# works but is deprecated (end of 2026).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). SERVER ONLY — bypasses all RLS and can read every
# user's MAL tokens. Never prefix with NEXT_PUBLIC_. Rotate immediately if leaked.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# MyAnimeList API — https://myanimelist.net/apiconfig
# App Type: "web". Register BOTH redirect URIs on the same client:
#   http://localhost:3000/api/mal/callback
#   https://<your-domain>/api/mal/callback
# ---------------------------------------------------------------------------
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# Must match a registered redirect URI EXACTLY (scheme, host, port, path,
# trailing slash). In production set this to the https:// one.
MAL_REDIRECT_URI=http://localhost:3000/api/mal/callback

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build OAuth redirect URLs and email links. In production this MUST be
# the deployed origin, or confirmation emails point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Minutes before a synced list is considered stale.
SYNC_STALE_MINUTES=60

# ---------------------------------------------------------------------------
# Deployment checklist (Supabase dashboard — not env vars)
# ---------------------------------------------------------------------------
# 1. Authentication → URL Configuration → Site URL = your production origin,
#    and add BOTH of these to Redirect URLs:
#       https://<your-domain>/auth/callback
#       http://localhost:3000/**          <- required to develop locally
#    A redirect_to that is not on this list is not an error: Supabase silently
#    substitutes the Site URL. Locally that lands you on the production
#    deployment, where your local session cookie does not exist, so the app
#    looks like it signed you out mid-OAuth.
# 2. Authentication → Providers → enable Google and Discord; add
#    https://<project-ref>.supabase.co/auth/v1/callback to each provider's
#    console as an authorized redirect URI.
# 3. Authentication → keep "Confirm email" ON. Same-email accounts only
#    auto-link when the address is verified; with it off you get duplicate
#    accounts that are painful to merge later.
# 4. Authentication → Advanced → enable Manual Linking, so users can attach a
#    provider that uses a different email address.
